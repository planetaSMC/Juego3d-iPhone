{
  "name": "rasmatic-vr-calibrator",
  "version": "1.0.0",
  "private": true,
  "description": "Centro de control y calibración VR para RASMATIC Lugar3D (Windows + iPhone)",
  "main": "electron/main.js",
  "author": "RASMATIC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/http.test.js test/protocol.test.js test/security.test.js test/spec.test.js test/store.test.js test/vrlink.test.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rasmatic.vrcalibrator",
    "productName": "RASMATIC VR Calibrator",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "renderer/**/*",
      "shared/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "game",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RASMATIC VR Calibrator",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
